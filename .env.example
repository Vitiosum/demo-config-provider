# Local run: node --env-file=.env.example server.js
# On Clever Cloud the four flags and FLEET_STATIONS come from the Configuration provider,
# STATION_NAME and PANEL_WIRING are set on each app.
PORT=8460
FEATURE_NIGHT_MODE=false
THEME_ACCENT=cherry
MAX_UPLOAD_MB=25
MAINTENANCE_BANNER=off
FLEET_STATIONS=http://localhost:8460,http://localhost:8466
STATION_NAME=Console A
PANEL_WIRING={"provider":["FEATURE_NIGHT_MODE","THEME_ACCENT","MAX_UPLOAD_MB","MAINTENANCE_BANNER","FLEET_STATIONS"],"app":["STATION_NAME"],"addon":"local-provider","tracedAt":"2026-11-01T00:00:00Z","otherAppVars":1}
